  <body>

  

     

<section class="about-section">

    <div class="about-left">

        <p class="about-small-title">
            ABOUT OUR BOOKSTORE
        </p>

        <h1>
            More Than Books,
            <span>We Share Stories.</span>
        </h1>

        <p>
            Welcome to BookStore, your trusted online destination for
            discovering books that inspire, educate, and entertain.
            We believe every book has the power to change lives,
            spark imagination, and build knowledge.
        </p>

        <p>
            Whether you're searching for bestselling novels,
            educational resources, or timeless classics,
            we make reading accessible through affordable prices
            and a smooth shopping experience.
        </p>

        <a href="/" class="about-btn">
            Browse Books
        </a>

    </div>

    <div class="about-right">

        <div class="about-image">

             <img  src= "<%= aboutImage %>" alt="">

        </div>

        

    </div>

</section>


<section class="mission">

    <div class="about-card">

        <h2> <img src= "<%= missionIcon %>" alt=""> Our Mission</h2>

        <p>
            To connect readers with books they love while providing
            excellent customer service and affordable pricing.
        </p>

    </div>

    <div class="about-card">

        <h2> <img src= "<%= deliveryIcon %>" alt=""> Fast Delivery</h2>

        <p>
            We carefully package every order and deliver your books
            safely to your doorstep.
        </p>

    </div>

    <div class="about-card">

        <h2> <img src= "<%= starIcon %>" alt=""> Quality Collection</h2>

        <p>
            From bestselling novels to educational materials,
            we continuously expand our catalog.
        </p>

    </div>

</section>



     
     

